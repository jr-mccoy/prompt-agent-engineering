    "python_join": "import json\nwith open('PROMPT_INDEX.json') as f:\n    index = json.load(f)\nwith open('PROMPT_INDEX_LEARNER_AUDIENCE.json') as f:\n    audience = json.load(f)['audience_tags']\nfor p in index['prompts']:\n    if p['path'] in audience:\n        p['learner_audience'] = audience[p['path']]\n# Filter to college-only prompts\ncollege_prompts = [p for p in index['prompts'] if 'college' in p.get('learner_audience', [])]",
